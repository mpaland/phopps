{
  "name": "phopps",
  "version": "0.1.0",
  "description": "PHOne aPPS framework",
  "author": "Marco Paland",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpaland/phopps.git"
  },
  "keywords": [
    ""
  ],
  "files": [
    "dist"
  ],
  "main": "dist/index",
  "typings": "dist/index",
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc --watch -p ./src ",
    "test": "mocha --opts tests/mocha.opts",
    "test-watch": "mocha --opts tests/mocha.opts --watch",
    "clean": "rm -rf dist",
    "lint": "tslint -c tslint.json 'src/**/*.ts'",
    "lint-fix": "tslint -c tslint.json 'src/**/*.ts' --fix",
    "dev": "lite-server"
  },
  "dependencies": {
    "express": "^4.17.1",
    "morgan": "1.10.0",
    "body-parser": "1.19.0",
    "cron-parser": "2.18.0",
    "path": "^0.12.7",
    "ip": "^1.1.5",
    "object-resolve-path": "^1.1.1",
    "comment-json": "^4.1.0",
    "xdate": "^0.8.2",
    "gm": "^1.23.1",
    "glob": "^7.1.6",
    "node-cache": "^5.1.2",
    "ini": "^2.0.0",
    "ldapjs": "^2.2.3",
    "html-to-text": "^6.0.0"
  },
  "devDependencies": {
    "ts-node": "latest",
    "tslint": "latest",
    "typescript": "^4.1.3",
    "chai": "^4.2.0",
    "lite-server": "^2.6.1",
    "mocha": "^8.2.1",
    "@types/body-parser": "^1.19.0",
    "@types/chai": "^4.2.14",

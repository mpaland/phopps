    "@types/express": "^4.17.9",
    "@types/glob": "^7.1.3",
    "@types/gm": "^1.18.9",
    "@types/html-to-text": "^6.0.0",
    "@types/ini": "^1.3.30",
    "@types/ip": "^1.1.0",
    "@types/ldapjs": "^1.0.9",
    "@types/mocha": "^8.2.0",
    "@types/morgan": "^1.9.2",
    "@types/node": "^14.14.20",
    "@types/xdate": "^0.8.31"
  },
  "engines": {
    "node": ">=6.10"
  }

{
  "name": "phopps",
  "version": "0.1.0",
  "description": "PHOne aPPS framework - XML services for Cisco and Snom IP phones",
  "author": "Marco Paland",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpaland/phopps.git"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test-watch": "vitest",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.8",
    "comment-json": "^5.0.0",
    "cron-parser": "^5.10.2",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.7",
    "html-to-text": "^10.0.1",
    "ini": "^7.0.0",
    "ldapts": "^9.2.0",
    "node-cache": "^5.1.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
